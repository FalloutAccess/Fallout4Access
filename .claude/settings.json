{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=$(jq -r \".tool_input.file_path // empty\"); [[ \"$FILE\" =~ \\.(cpp|h|hpp)$ ]] && clang-format -i \"$FILE\" || true'"
          }
        ]
      }
    ]
  }
}
