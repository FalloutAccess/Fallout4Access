#include <F4SE/F4SE.h>

// Custom plugin manifest for fallout4access (passed to the commonlibf4.plugin
// rule via plugin_template). Must be named commonlibf4-plugin.cpp.in so its
// generated output matches the commonlibf4-plugin.cpp the rule adds to files.
//
// The only meaningful delta from CommonLibF4's default template is that we omit
// the two NG (1.10.984) independence bits. We also drop its
// CompatibleVersions({ RUNTIME_LATEST }) line, but that is cosmetic: F4SE's
// PluginManager::checkPluginCompatibility only consults compatibleVersions when
// the plugin is NOT version-independent, and AddressLibrary_1_11_137 +
// 1_11_137Layout make us independent on every AE patch.
//
// Why NG is deliberately excluded: those bits are load gates, not metadata.
// UsesAddressLibraryNG/IsLayoutDependentNG tell F4SE it may load us on NG, but
// REL::VariantID's ctor pads trailing slots with its LAST argument, so our
// { OG, AE } callsites become [OG, AE, AE] and REX::FModule::GetRuntimeIndex
// maps NG to slot 1 -- i.e. NG would resolve AE ids against the NG address
// library. HUDDataModel id 4801904 is absent from version-1-10-984-0.bin
// entirely, so HUDMenuHook's quick-container path would fault there. Leaving
// the bits unset makes F4SE refuse the load cleanly instead.
//
// To support NG: find real NG ids for the 5 REL::VariantID callsites
// (HUDMenuHook.cpp, HUDMessageHook.h), widen them to 3 args, then delete this
// file and let the rule fall back to the upstream template.
//
// AE 1.11.137+ is covered by UsesAddressLibrary + IsLayoutDependent with no
// version pin. OG 1.10.163 is handled separately by the legacy
// F4SEPlugin_Query export in src/main.cpp (enabled by SUPPORT_OG).
F4SE_PLUGIN_VERSION = []() noexcept {
    F4SE::PluginVersionData v{};
    v.PluginVersion({ ${COMMONLIB_PLUGIN_VERSION_MAJOR}, ${COMMONLIB_PLUGIN_VERSION_MINOR}, ${COMMONLIB_PLUGIN_VERSION_PATCH}, 0 });
    v.PluginName("${COMMONLIB_PLUGIN_NAME}");
    v.AuthorName("${COMMONLIB_PLUGIN_AUTHOR}");
    v.UsesAddressLibrary(true);
    // v.UsesAddressLibraryNG(true);  // deliberately unset -- see above
    v.UsesSigScanning(false);
    v.IsLayoutDependent(true);
    // v.IsLayoutDependentNG(true);   // deliberately unset -- see above
    v.HasNoStructUse(false);
    return v;
}();
